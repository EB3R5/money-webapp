# Copy to .env and fill in. NEVER commit .env.

# Data directory (ADR-0010): the SQLite file plus photos/ and models/. Default ./data.
DATA_DIR="data"

# Session auth — signs the login cookie. Required: the app refuses to start when it is
# empty. Generate a fresh value:
#   python -c "import secrets;print(secrets.token_hex(32))"
# SESSION_MAX_AGE = login lifetime in seconds (default 86400 = 24 hours; 7d = 604800).
SESSION_SECRET=""
SESSION_MAX_AGE="86400"
# Set "true" in prod (served over HTTPS). Leave false for local http dev.
SESSION_HTTPS_ONLY="false"
# The public origin the app is reached on (scheme, host, port): the request hosts Django
# accepts, the origins its CSRF check trusts, what the clipper bookmarklets and the
# invitation / reset links bake in. Leave empty for loopback-only use. (CLIP_BASE_URL is the
# old name; it still works, with a warning at start.)
BASE_URL=""
# Behind a reverse proxy that is NOT on this host (another container, another machine): its
# address or range, comma-separated, so the login rate limiter sees real visitor addresses
# from X-Forwarded-For (walked from the right past every trusted hop; a client-supplied
# value is never believed on its own). Loopback is always trusted. Inside Docker a proxy on
# the host arrives from the bridge gateway, not loopback: the reference compose.yml sets
# 172.16.0.0/12 for that case. Leave empty for the venv server behind a proxy on this host.
TRUSTED_PROXIES=""

# First account (ADR-0024). Leave both empty and the first visit to /login is a setup form
# where the first person chooses the admin's username and password. For a headless
# deployment set both: the first start creates that admin and insists on a password change
# at the first sign-in. More users: /admin/.
DEFAULT_USER=""
DEFAULT_PASSWORD=""

# SimpleFIN feed (app/simplefin). The Access URL is the read-only credential for every
# linked bank — treat it like a password: environment only, never the database or git.
# Get it once from a setup token:  python -m app.simplefin.claim --stdin
# Leave empty to keep the feed off.
SIMPLEFIN_ACCESS_URL=""
# Feed limits (defaults shown): requests per UTC day the sync may spend (Bridge allows 24),
# first run's lookback, days re-read behind the cursor, and the max days per request
# (Bridge caps at 90 and warns above 45).
SIMPLEFIN_DAILY_BUDGET="20"
SIMPLEFIN_INITIAL_LOOKBACK_DAYS="90"
SIMPLEFIN_OVERLAP_DAYS="5"
SIMPLEFIN_MAX_WINDOW_DAYS="45"
# Scheduling: a run every N hours at a fixed minute; a catch-up 20 s after start when the
# last success is older than SYNC_STALE_HOURS. Only registered when the Access URL is set.
SYNC_INTERVAL_HOURS="6"
SYNC_CRON_MINUTE="17"
SYNC_STALE_HOURS="12"

# Auto-categorization ML model. Runs in-process; the joblib file lives under DATA_DIR/models
# (no external call, no API key); the first model is trained from the categorized ledger.
# ML_MODEL_NAME names the model; ML_CONF_MIN hides weak suggestions.
ML_MODEL_NAME="category_model"
ML_CONF_MIN="0.0"
